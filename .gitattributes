# Auto-detect text files, normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text files (helps when auto-detect is ambiguous)
*.php       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.htaccess  text eol=lf
.gitignore  text eol=lf
.gitkeep    text eol=lf

# Binary files — never touch these
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.pdf       binary
*.ico       binary
*.zip       binary